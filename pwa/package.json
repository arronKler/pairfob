{
  "name": "pairfob-pwa",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "typecheck:qa": "tsc --noEmit -p tsconfig.qa.json",
    "dev": "vite",
    "build": "vite build",
    "live": "bun scripts/live-session.ts",
    "perf:live-input": "bun scripts/live-input-benchmark.ts",
    "perf:terminal:command": "bun scripts/terminal-command-benchmark.ts",
    "perf:terminal:browser": "bun run build && bun scripts/terminal-browser-benchmark.ts",
    "perf:terminal": "bun run perf:terminal:command && bun run perf:terminal:browser"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "hash-wasm": "^4.12.0",
    "marked": "^18.0.11",
    "qr-scanner": "1.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remend": "^1.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "happy-dom": "^20.11.12",
    "sass": "^1.104.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
