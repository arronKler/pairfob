{
  "name": "pairfob-origin",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal", "request_signal_passthrough"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "BUILD": "2026-10-10.12",
    "P2P_OPEN": "1",
    // Expiring metadata-only diagnostic sample; never logs frame payloads.
    "ROOM_DIAGNOSTICS_SAMPLE_RATE": "0.01",
    "ROOM_DIAGNOSTICS_UNTIL": "2026-10-11T10:00:00Z",
    "ROOM_DIAGNOSTICS_OBJECT_IDS": "22a40dc911cc8e0ca4f83ac7a8d91c0ecb4cb18717c422bfb2ef3370a2f255fd,aeef184f70045599eced8b1b41155f79e6b2010f730b9e2c1f9f799a4c777c8c,59128816b1349103f43758a5f0ecb521a7fff88ada558b5fb4c417015511983b,8929b6dcfd3af8d8345d48cbd57b3f144ead9b5e24a4ea2470076292ac4372c1,2ee81604763e0e46bac215c614ad9a472a9bf144faeb8046f6581dfb096836dd"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "analytics_engine_datasets": [
    { "binding": "METRICS", "dataset": "pairfob" }
  ],
  "routes": [
    { "pattern": "pairfob.com", "custom_domain": true },
    { "pattern": "www.pairfob.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pairfob",
      "database_id": "bcdc6770-16be-4256-ba7a-1a20decfff12",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DAEMON_ROOM", "class_name": "DaemonRoom" },
      { "name": "PAIRING_INDEX", "class_name": "PairingIndex" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DaemonRoom", "PairingIndex"]
    }
  ],
  "assets": {
    "directory": "./public-dist",
    "binding": "ASSETS",
    // Folder indexes (`/doc/`, `/doc/zh/`) must keep the trailing slash:
    // VitePress `base` is `/doc/`. drop-trailing-slash 307s those URLs away.
    // `/pair` and `/zh` are fetched as opaque shells in the Worker.
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  }
}
