{
  "name": "pairfob-origin",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "BUILD": "test",
    "P2P_OPEN": "1"
  },
  "analytics_engine_datasets": [
    { "binding": "METRICS", "dataset": "pairfob" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pairfob",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DAEMON_ROOM", "class_name": "DaemonRoom" },
      { "name": "PAIRING_INDEX", "class_name": "PairingIndex" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DaemonRoom", "PairingIndex"]
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
